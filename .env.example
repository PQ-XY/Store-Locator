DATABASE_URL=postgresql+psycopg://your_local_db_user:your_local_db_password@localhost:5432/your_local_db_name

# Redis configuration (optional - uses defaults if not set)
# Caching: geocoding (30 days), search results (10 minutes)
# Rate limiting: 10 requests/minute, 100 requests/hour per IP
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Enable cache operation logs (hit/miss/set/clear)
CACHE_EVENTS_ENABLED=false

# JWT configuration
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
